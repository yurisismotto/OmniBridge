#!/usr/bin/env bash
# TEST ONLY — a QR: the payload it was given, so a test can read what was shown.
out=""; payload=""
while [ $# -gt 0 ]; do
    case "$1" in -o) out="$2"; shift 2 ;; -t|-s|-m) shift 2 ;; -*) shift ;; *) payload="$1"; shift ;; esac
done
if [ -n "$out" ]; then printf 'FAKEPNG %s\n' "$payload" > "$out"; else printf '[QR %s]\n' "$payload"; fi
