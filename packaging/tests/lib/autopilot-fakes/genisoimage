#!/usr/bin/env bash
# TEST ONLY — a "seed ISO": the input files, each under a header, so the fake
# virsh can emulate cloud-init from it.
out=""; files=()
while [ $# -gt 0 ]; do
    case "$1" in
        -output|-o) out="$2"; shift 2 ;;
        -volid|-V) shift 2 ;;
        -*) shift ;;
        *) files+=("$1"); shift ;;
    esac
done
[ -n "$out" ] || exit 2
{ for f in "${files[@]}"; do printf '## FILE: %s\n' "$(basename "$f")"; cat "$f"; printf '\n'; done; } > "$out"
